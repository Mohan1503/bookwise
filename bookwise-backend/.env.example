DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
ADMIN_UPLOADS_ENABLED=false
MAX_UPLOAD_SIZE_MB=50
STORAGE_ROOT=storage
STORAGE_PROVIDER=local
FILEBASE_ACCESS_KEY=
FILEBASE_SECRET_KEY=
FILEBASE_ENDPOINT=https://s3.filebase.io
FILEBASE_BUCKET=bookwise-books
FILEBASE_REGION=auto
# AI Reader: AI_PROVIDER is anthropic (Claude) or groq
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b
AI_QUERY_REWRITE=true
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
AI_REQUESTS_PER_HOUR=30
AI_AUTO_INDEX_UPLOADS=true
EMBEDDING_MODEL=ibm-granite/granite-embedding-small-english-r2
EMBEDDING_BATCH_SIZE=1
AI_PRELOAD_MODEL=true
